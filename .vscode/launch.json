    "version": "0.2.0",
    "configurations": [
        {
            "name": "intranode",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            // "subProcess": false,
            "env": {},
            "cwd": "${workspaceFolder}/deepseek-ep",
            "program": "tests/test_intranode.py",
            "args": [
                "--num-processes", "2",
                // "--use-fabric"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}